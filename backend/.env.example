# Local/dev-box overrides for app/config.py Settings (SCREENING_ prefix).
# Copy to .env and adjust as needed.

# docker-compose's Postgres container maps to host port 5433, not the
# default 5432 -- this dev box has a native PostgreSQL service already
# bound to :5432. If your machine has no native Postgres on :5432, you
# can drop this override and use the default 5432:5432 mapping instead.
SCREENING_DATABASE_URL=postgresql+asyncpg://screening:screening@localhost:5433/screening

# See app/pipeline/branches/ocr.py's warm_up(); measured on this dev box
# warm RapidOCR VIZ inference is ~1.3-1.6s, above the 700ms production
# default (BACKEND_BRIEF.md §5.3).
SCREENING_OCR_BUDGET_MS=2500

# Dev-only: plain-http dev servers can't set a Secure cookie. See
# app/auth/routes.py for why this is safe -- it must stay unset (default
# True/Secure) in any deployment that actually serves https.
SCREENING_SESSION_COOKIE_SECURE=false
