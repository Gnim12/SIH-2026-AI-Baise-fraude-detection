+/** Model pins actually running, from GET /api/health. null until known or if unavailable. */
+function useRunningModelPins(): string | null {
+  const [pins, setPins] = useState<string | null>(null);
+  useEffect(() => {
+    let cancelled = false;
+    fetchNodeHealth()
+      .then((nodes) => {
+        if (cancelled) return;
+        const list = nodes.map((n) => n.pin).filter((p): p is string => !!p);
+        setPins(list.length > 0 ? list.join(' · ') : null);
+      })
+      .catch(() => {
+        if (!cancelled) setPins(null);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+  return pins;
+}
 
